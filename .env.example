# ────────────────────────────────────────────────────────────
# AI Personal Assistant - Environment Configuration Template
# ────────────────────────────────────────────────────────────

# ─── Google Gemini Provider ───
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# ─── OpenRouter Provider (Qwen, Llama, Mistral, etc.) ───
# Get your FREE key at: https://openrouter.ai/keys
# Free Qwen models: qwen/qwen3-235b-a22b:free, qwen/qwen-2.5-72b-instruct:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=qwen/qwen3-235b-a22b:free,qwen/qwen-2.5-72b-instruct:free

# ─── How Model Cascade Works ───
# The system tries models in this order:
#   1. All GEMINI_MODELS (left to right)
#   2. All OPENROUTER_MODELS (left to right)
#   3. If ALL fail -> Local SimulatedAgentModel (offline fallback)

# ─── Server Settings ───
HOST=0.0.0.0
PORT=8000
DEBUG=True

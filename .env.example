# Gemini API Key (Required for Google GenAI integration)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Cascade (comma-separated, tried in order if quota exhausted on one)
GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-flash,gemini-2.5-pro

# Legacy single model (used as primary fallback)
GEMINI_MODEL=gemini-2.0-flash

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
